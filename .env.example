# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_TIMEOUT=30000

# LLM Service
VITE_LLM_API_KEY=your_llm_api_key_here
VITE_LLM_MODEL=gpt-4

# Vector Database
VITE_VECTOR_DB_URL=http://localhost:6333
VITE_VECTOR_DB_API_KEY=your_vector_db_key

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Music Service
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_MUSIC_API_URL=http://localhost:8000

# App Settings
VITE_APP_NAME=Aria
VITE_APP_VERSION=0.1.0
VITE_LOG_LEVEL=info
